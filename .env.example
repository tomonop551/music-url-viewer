# Cloudflare（OpenNext on Workers）向け環境変数
# 本番は wrangler.toml [vars] / `wrangler secret put` で設定。ローカル開発はこのファイルを .env にコピー。

# ローカル開発のデータ源。`fixture` にすると同梱フィクスチャ（src/lib/catalog/fixtures/）を表示し、
# D1 の資格情報も Cloudflare のバインディングも無い状態で一覧とプレイリスト画面を確認できる。
# 既定（未設定）は現行どおり D1 経路。本番の wrangler.toml [vars] には設定しない。
MUSIC_DATA_SOURCE=fixture

APP_ORIGIN=http://localhost:3000

MUSICBRAINZ_USER_AGENT=music-url-viewer/0.1 (+https://github.com/tomonop551/music-url-viewer)

# Basic 認証。未設定時は認証ゲートが無効（素通し）。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# AI 濃縮・提案（OpenRouter）。モデルは wrangler.toml [vars] で設定する
OPENROUTER_API_KEY=
