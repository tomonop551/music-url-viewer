# Cloudflare（OpenNext on Workers）向け環境変数
# 本番は wrangler.toml [vars] / `wrangler secret put` で設定。ローカル開発はこのファイルを .env にコピー。

APP_ORIGIN=http://localhost:3000

MUSICBRAINZ_USER_AGENT=music-url-viewer/0.1 (+https://github.com/tomonop551/music-url-viewer)

# Basic 認証。未設定時は認証ゲートが無効（素通し）。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# OAuth（Auth.js / Spotify）
AUTH_SECRET=
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# AI 濃縮・提案（OpenRouter）。モデルは wrangler.toml [vars] で設定する
OPENROUTER_API_KEY=
