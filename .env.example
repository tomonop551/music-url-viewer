# Cloudflare（OpenNext on Workers）向け環境変数
# 本番は wrangler.toml [vars] / `wrangler secret put` で設定。ローカル開発はこのファイルを .env にコピー。

# チャット API の発信元検証（実ドメイン確定後に本番へ設定）
APP_ORIGIN=http://localhost:3000

# 日次チャット利用枠（アトミック加算は D1 music_chat_budget で管理）
CHAT_DAILY_LIMIT=200

# Workers AI の function calling 対応モデル（要実機検証）
AI_MODEL_ID=@cf/moonshotai/kimi-k2.7-code

# MusicBrainz API 利用時の User-Agent（利用規定遵守）
MUSICBRAINZ_USER_AGENT=music-url-viewer/0.1 (+https://github.com/tomonop551/music-url-viewer)

# Basic 認証（src/proxy.ts）。本番は平文を git に入れず `wrangler secret put` で設定する。
# ローカル開発でのみこのファイルを .env にコピーして検証する。未設定時は認証ゲートが無効（素通し）。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=