{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "storybook",
      "matchPackageNames": [
        "storybook",
        "@storybook/{/,}**",
        "@chromatic-com/storybook"
      ]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": [
        "vitest",
        "@vitest/{/,}**"
      ]
    },
    {
      "groupName": "types",
      "matchPackageNames": [
        "@types/{/,}**"
      ]
    }
  ]
}
